# Copy to .env and fill in what you need. Never commit a real token.

# Telegram bot token from @BotFather (bot service only)
BOT_TOKEN=

# Speech recognition routing: auto (default), persian or whisper.
# auto sends Persian audio to the Persian fine-tuned model and
# everything else to faster-whisper.
SUBFA_ASR_ENGINE=auto
# faster-whisper model for non-Persian audio
SUBFA_WHISPER_MODEL=large-v3-turbo
# Persian fine-tuned model (HF id or local folder)
SUBFA_PERSIAN_MODEL=nezamisafa/whisper-persian-v4
# Folder filled by `subfa download-models` for fully offline runs
SUBFA_MODEL_CACHE=~/.cache/subfa/models
# Anti-hallucination decoding for faster-whisper
SUBFA_BEAM_SIZE=5
SUBFA_VAD_FILTER=on
SUBFA_NO_SPEECH_THRESHOLD=0.6
SUBFA_LOG_PROB_THRESHOLD=-1.0
SUBFA_COMPRESSION_RATIO_THRESHOLD=2.4
SUBFA_CONDITION_ON_PREVIOUS_TEXT=off
# Torch dtype for the Persian transformers engine
SUBFA_PERSIAN_DTYPE=float16
# Translation engine: argos (offline) or none
SUBFA_TRANSLATOR=argos
# Upload cap for files, in MB
SUBFA_MAX_FILE_MB=200
# Link downloads: duration cap in minutes, size cap in MB, max height
SUBFA_MAX_DURATION_MIN=60
SUBFA_MAX_DOWNLOAD_MB=500
SUBFA_DOWNLOAD_MAX_HEIGHT=720
# Published captions fast path: on or off
SUBFA_CAPTIONS=on
# Subtitle font used for burn-in
SUBFA_FONT=Vazirmatn
# Burn-in style preset: cinema, reels or learning
SUBFA_STYLE=cinema
# Digit style in Persian output: fa, en or keep
SUBFA_DIGITS=fa
